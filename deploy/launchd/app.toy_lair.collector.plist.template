<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.toy_lair.collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>toy_lair_assistant.collector</string>
    <string>poll</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__/services/assistant</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>__COLLECTOR_INTERVAL__</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/collector.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/collector.err.log</string>
</dict>
</plist>
